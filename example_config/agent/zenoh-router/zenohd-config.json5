{
  scouting: {
    timeout: 3000,
    delay: 500,
    multicast: {
      enabled: false,
    },
    gossip: {
      enabled: true,
      multihop: true,
    },
  },
  plugins: {
    storage_manager: {
      storages: {
        all: {
          key_expr: "**",
          volume: "memory"
        }
      }
    },
    rest: { http_port: 8000 }
  }
}
